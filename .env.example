PORT=8788
CAISHEN_HOST=0.0.0.0
CAISHEN_DATA_DIR=./data
CAISHEN_WORKSPACE_ID=local

# 生图服务：只在服务端配置，不会发送到浏览器。
CAISHEN_API_SERVICE_URL=
CAISHEN_API_BASE_URL=https://api.change2pro.com
CAISHEN_IMAGE_API_KEY=
# 旧版兼容：CAISHEN_API_KEY 只会作为图片密钥迁移。
CAISHEN_API_KEY=
CAISHEN_IMAGE_MODEL=gpt-image-2
CAISHEN_ANALYSIS_MODEL=gpt-5-6
CAISHEN_IMAGE_RESPONSE_FORMAT=url
# 全局自适应生图队列：从 8 开始，健康时逐步升到 30，限流时自动降速。
CAISHEN_IMAGE_API_INITIAL_CONCURRENCY=8
CAISHEN_IMAGE_API_MAX_CONCURRENCY=30
CAISHEN_IMAGE_API_START_INTERVAL_MS=500
CAISHEN_IMAGE_API_MAX_ATTEMPTS=8
CAISHEN_IMAGE_API_BACKOFF_BASE_MS=1000
CAISHEN_IMAGE_API_BACKOFF_MAX_MS=120000
CAISHEN_IMAGE_API_TIMEOUT_MS=300000
CAISHEN_IMAGE_URL_TIMEOUT_MS=300000
CAISHEN_FILE_TOKEN_SECRET=
CAISHEN_SESSION_SECRET=

# 双业务经营账本：与永沙服务器填写完全相同的随机长密钥。
CAISHEN_BUSINESS_LINK_SECRET=
# 永沙服务地址，用于共用同一张 Alipay 收款码。
CAISHEN_YONGSHA_BUSINESS_URL=
